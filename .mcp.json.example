{
  "_comment": "Lokale MCP-Server-Konfiguration fuer google-ads-agent. Kopiere als .mcp.json und ersetze <YOUR_N8N_HOST> + <YOUR_N8N_MCP_BEARER_TOKEN>. .mcp.json ist via .gitignore vom Commit ausgeschlossen.",

  "_hint_n8n_host": "Hostname deiner self-hosted n8n-Instanz, z.B. 'n8n.example.com' (ohne 'https://')",
  "_hint_bearer_token": "Master-Bearer-Token fuer alle 9 MCP-Endpoints. Wird in n8n unter Credentials -> 'Header Auth' angelegt (siehe docs/SETUP.md Schritt 5.4).",

  "mcpServers": {
    "google-ads-account": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-account-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "google-ads-campaigns": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-campaign-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "google-ads-ad-groups": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-ad-group-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "google-ads-ads": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-ad-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "google-ads-keywords": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-keyword-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "google-ads-reporting": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-reporting-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "google-ads-insights": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-insights-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "google-ads-gaql": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/google-ads-gaql-tools",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },
    "dataforseo": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/dataforseo-mcp-v2",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },

    "_optional_mail_bridge_comment": "Falls du die Mail-Bridge als separaten MCP-Server gebaut hast (siehe docs/SETUP.md Schritt 6.3), aktiviere den folgenden Server. Sonst loeschen.",
    "mail-bridge": {
      "type": "http",
      "url": "https://<YOUR_N8N_HOST>/mcp/mail-bridge",
      "headers": {
        "Authorization": "Bearer <YOUR_N8N_MCP_BEARER_TOKEN>"
      }
    },

    "n8n-mcp": {
      "_comment": "czlonkowski/n8n-mcp via globale npm-Installation. Vorab: 'npm install -g n8n-mcp@latest'. Dieser MCP wird fuer Workflow-Engineering (Build/Validate/Update) genutzt, nicht fuer Reports.",
      "command": "n8n-mcp",
      "args": [],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://<YOUR_N8N_HOST>",
        "N8N_API_KEY": "<your-n8n-api-key-from-env>"
      }
    }
  }
}
