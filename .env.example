# google-ads-agent — n8n Environment Variables Template
# Kopiere diese Datei nach .env und befuelle die Platzhalter.
# .env ist via .gitignore vom Commit ausgeschlossen.
#
# Diese Variablen werden NUR fuer Workflow-Engineering von ausserhalb n8n verwendet
# (z.B. wenn du Workflows per CLI/Script aktualisieren willst). Innerhalb von n8n
# selbst werden alle Credentials ueber das n8n-Credential-System verwaltet
# (siehe docs/SETUP.md Schritt 5).

# === n8n Public API ===
# Generieren in n8n: Profile-Icon -> Settings -> n8n API -> "Create an API key"
# Optional: nur fuer Workflow-Bulk-Update via Script benoetigt
N8N_API_KEY=<your-n8n-jwt-token>
N8N_BASE_URL=https://<your-n8n-host>
