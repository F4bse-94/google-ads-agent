# google-ads-agent — Lokale Credentials Template
# Kopiere diese Datei nach .env und befuelle die Platzhalter.
# .env ist via .gitignore vom Commit ausgeschlossen.

# === n8n Public API ===
# Wird vom n8n-mcp-Tool fuer Workflow-Management verwendet (Build/Validate/Update).
# Generieren in n8n: Profile-Icon -> Settings -> n8n API -> "Create an API key"
N8N_API_KEY=<your-n8n-jwt-token>
N8N_BASE_URL=https://<your-n8n-host>

# === Optional: GitHub PAT fuer lokale Memory-Reads ===
# Nur noetig wenn du das Memory-Repo NICHT als Submodule mountest, sondern via API liest.
# Scope: 'repo' (Full control of private repositories)
# GITHUB_MEMORY_PAT=ghp_xxx

# === Optional: Anthropic API-Key ===
# Nur noetig wenn du die scripts/ Python-Skripte direkt aufrufst (z.B. fuer Stats-Tests
# ausserhalb des n8n-Statistiker-Workflows). Sub-Agents in n8n nutzen ihre eigenen
# AI-Provider-Credentials.
# ANTHROPIC_API_KEY=sk-ant-xxx

# === Optional: Debug-Mode ===
# DEBUG=1
# LOG_LEVEL=debug
