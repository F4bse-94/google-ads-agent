              "value": "<your-email@example.com>",
              "type": "string"
            },
            {
              "id": "m9",
              "name": "user_message",
              "value": "=Generate the Weekly Google Ads Report for {{ $json.iso_week }}. Execute in this order:\n\n1. read_memory_file for '00_strategy_manifest.md', '02_findings_log.md', '03_pending_actions.md' — collect as memory_context\n2. Call all 4 workers IN PARALLEL with the briefing structure:\n   - call_performance_analyst: time_window=LAST_7_DAYS, customer_id=<YOUR_CUSTOMER_ID>\n   - call_search_keyword_hunter: time_window=LAST_14_DAYS, customer_id=<YOUR_CUSTOMER_ID>\n   - call_statistician: hypotheses_to_test = open items from findings_log, time_window_default=LAST_30_DAYS\n   - call_market_competitive: time_window=LAST_30_DAYS\n3. call_report_composer with all 4 worker outputs + memory_context + recipient_email='<your-email@example.com>' + iso_week + year + start_date + end_date.\n4. Return JSON summary with composer's output.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
